---
/**
 * Notas da entrega. NÃO faz parte do site final: é a página de conferência
 * para o cliente, com o que já está no ar, onde cada fotografia entra e o que
 * ainda depende da padaria.
 *
 * O estado de cada foto é lido do disco (`temFoto`), não digitado à mão: se o
 * arquivo estiver em `public/images`, aparece "no ar".
 */
import site from '../content/site.json';
import menu from '../content/menu.json';
import { slots, temFoto } from '../lib/fotos';
import { enderecoCompleto, horarioLongo } from '../lib/negocio';

const totalItens = menu.categorias.reduce((soma, categoria) => soma + categoria.itens.length, 0);
const fotosNoAr = slots.filter((foto) => temFoto(foto.arquivo)).length;

const aplicados = [
  `WhatsApp comercial ${site.whatsapp.numeroExibido}, com link ativo em todos os CTAs`,
  `Endereço ${enderecoCompleto}`,
  `Horário ${horarioLongo}`,
  `Cardápio com preços: ${menu.categorias.length} categorias, ${totalItens} itens`,
  `Nota ${site.google.nota} no Google, ${site.google.avaliacoes} avaliações`,
  'Rodapé, Schema.org, robots e sitemap gerados a partir dos mesmos dados',
];

const pendencias = [
  {
    titulo: 'Logotipo em vetor',
    texto: 'Header e favicon. Hoje o header usa um bloco reservado com a palavra LOGO.',
  },
  {
    titulo: 'Citações de avaliação',
    texto: 'Só entram com autorização de quem escreveu; a seção mostra a nota e a distribuição.',
  },
  {
    titulo: 'Distribuição das notas',
    texto: 'Os percentuais do gráfico vêm da referência enviada e serão conferidos no perfil do Google.',
  },
  {
    titulo: 'Domínio',
    texto: 'panificadoraoliveira.com.br ainda não resolve; hoje o endereço público é o da Vercel.',
  },
];
---

<section class="notas" aria-labelledby="notas-titulo">
  <div class="container">
    <p class="notas__etiqueta">Notas da entrega — fora do site final</p>
    <h2 id="notas-titulo" class="notas__titulo">O que está no ar e o que depende da padaria</h2>

    <div class="notas__grade">
      <div class="notas__coluna">
        <h3 class="notas__subtitulo">Já aplicado</h3>
        <ul class="notas__lista">
          {aplicados.map((linha) => <li>{linha}</li>)}
        </ul>
        <p class="notas__texto">
          Nenhuma imagem gerada ficou no site. Cada seção guarda a proporção da foto real e mostra
          a moldura com o nome do arquivo enquanto ele não chega — {fotosNoAr} de
          {' '}{slots.length} fotos já estão em <code>public/images</code>.
        </p>
      </div>

      <div class="notas__coluna">
        <h3 class="notas__subtitulo">Onde entram as fotos</h3>
        <table class="notas__tabela">
          <caption class="sr-only">Fotos previstas, onde aparecem e em que proporção</caption>
          <thead>
            <tr>
              <th scope="col">Foto</th>
              <th scope="col">Onde</th>
              <th scope="col">Proporção</th>
              <th scope="col">Arquivo</th>
            </tr>
          </thead>
          <tbody>
            {
              slots.map((foto) => {
                const noAr = temFoto(foto.arquivo);
                return (
                  <tr>
                    <td>{foto.rotulo}</td>
                    <td>{foto.onde}</td>
                    <td class="notas__formato">{foto.formato}</td>
                    <td>
                      <span class:list={['notas__estado', { 'notas__estado--pendente': !noAr }]}>
                        {noAr ? 'no ar' : 'aguardando'}
                      </span>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>

        <h3 class="notas__subtitulo notas__subtitulo--seguinte">Ainda depende da padaria</h3>
        <ul class="notas__lista">
          {
            pendencias.map((item) => (
              <li>
                <strong>{item.titulo}</strong> — {item.texto}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="notas__rodape">
      <a href="/prototipo">Abrir as duas telas lado a lado (390 px e 1280 px)</a>
    </p>
  </div>
</section>

<style>
  .notas {
    padding-block: var(--e8);
    background-color: var(--miolo);
    border-top: 1px solid var(--borda-forte);
  }

  .notas__etiqueta {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--tinta-suave);
  }

  .notas__titulo {
    margin-top: var(--e2);
    max-width: 30ch;
    font-size: var(--t-h3);
  }

  .notas__grade {
    display: grid;
    gap: var(--e7);
    margin-top: var(--e6);
  }

  .notas__subtitulo {
    padding-bottom: var(--e2);
    border-bottom: 1px solid var(--borda-forte);
    font-family: var(--fonte-texto);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--crosta);
  }

  .notas__subtitulo--seguinte {
    margin-top: var(--e6);
  }

  .notas__lista {
    display: grid;
    gap: var(--e2);
    margin-top: var(--e3);
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--tinta-suave);
  }

  .notas__lista li {
    padding-left: var(--e4);
    border-left: 2px solid var(--pedra);
  }

  .notas__lista strong {
    color: var(--crosta);
  }

  .notas__texto {
    margin-top: var(--e4);
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--tinta-suave);
    max-width: 52ch;
  }

  .notas__tabela {
    width: 100%;
    margin-top: var(--e3);
    border-collapse: collapse;
    font-size: var(--t-sm);
  }

  .notas__tabela th,
  .notas__tabela td {
    padding: var(--e3) var(--e3) var(--e3) 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--borda);
  }

  .notas__tabela th {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--tinta-suave);
  }

  .notas__tabela td {
    color: var(--crosta);
    line-height: 1.5;
  }

  .notas__formato {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--tinta-suave);
  }

  .notas__estado {
    display: inline-block;
    padding: 2px var(--e2);
    border: 1px solid var(--borda-forte);
    border-radius: var(--r-pill);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.6;
    white-space: nowrap;
    color: var(--tinta-suave);
  }

  .notas__estado--pendente {
    border-style: dashed;
  }

  .notas code {
    font-size: 0.875em;
    color: var(--crosta);
  }

  .notas__rodape {
    margin-top: var(--e7);
    padding-top: var(--e4);
    border-top: 1px solid var(--borda);
    font-size: var(--t-sm);
  }

  .notas__rodape a {
    color: var(--crosta);
    text-underline-offset: 4px;
  }

  @media (min-width: 900px) {
    .notas__grade {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: var(--e8);
    }
  }
</style>
