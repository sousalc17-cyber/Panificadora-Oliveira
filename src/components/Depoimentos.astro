---
/**
 * Avaliações — seção concluída com os dados que já existem.
 *
 * Entra só o que a padaria forneceu: a nota 4,5, o total de 50 avaliações e a
 * distribuição por estrela da referência enviada (`google.distribuicao`).
 * Enquanto `distribuicaoConfirmada` for `false`, a ressalva em texto avisa que
 * os percentuais ainda serão conferidos no perfil — sem gráfico inventado
 * passando por dado oficial.
 *
 * Não há cartão em branco nem carrossel: sem citação autorizada, a seção se
 * explica em texto. Quando `site.avaliacoes` receber textos com autorização,
 * eles entram em lista; quando `google.url` existir, o link do perfil aparece.
 */
import site from '../content/site.json';

const { google } = site;
const avaliacoes = site.avaliacoes as { autor: string; texto: string }[];
const notas = [5, 4, 3, 2, 1];
const distribuicao = google.distribuicao as Record<string, number>;
const percentual = (nota: number) => Math.min(100, Math.max(0, distribuicao[String(nota)] ?? 0));
const distribuicaoResumo = notas
  .map((nota) => `${nota} ${nota === 1 ? 'estrela' : 'estrelas'}: ${percentual(nota)}%`)
  .join('; ');
const estrelasCheias = Math.floor(Number(String(google.nota).replace(',', '.')));
---

<section class="nota" id="avaliacoes" aria-labelledby="nota-titulo">
  <div class="container nota__interno">
    <div class="nota__placar">
      <p class="nota__valor">
        {google.nota}<span class="nota__de">de 5</span>
      </p>

      <p class="nota__estrelas" role="img" aria-label={`Nota ${google.nota} de 5`}>
        {
          [1, 2, 3, 4, 5].map((indice) => (
            <span
              class:list={['nota__estrela', { 'nota__estrela--cheia': indice <= estrelasCheias }]}
              aria-hidden="true"
            >
              ★
            </span>
          ))
        }
      </p>

      <p class="nota__contagem">{google.avaliacoes} avaliações no Google</p>

      <div
        class="nota__distribuicao"
        role="img"
        aria-label={`Distribuição das notas — ${distribuicaoResumo}`}
      >
        {
          notas.map((nota) => (
            <div class="nota__linha" aria-hidden="true">
              <span class="nota__linha-nota">{nota}</span>
              <span class="nota__trilho">
                <span class="nota__barra" style={`width: ${percentual(nota)}%`} />
              </span>
            </div>
          ))
        }
      </div>

      {
        !google.distribuicaoConfirmada && (
          <p class="nota__ressalva">
            Percentuais da referência enviada pela padaria; conferimos com o perfil no Google
            antes de publicar.
          </p>
        )
      }
    </div>

    <div class="nota__conteudo">
      <p class="eyebrow">Avaliações</p>
      <h2 id="nota-titulo" class="nota__titulo">
        A nota de quem já passou por aqui
      </h2>
      <p class="nota__paragrafo">
        A nota {google.nota} é do perfil da Panificadora Oliveira no Google, com
        {' '}{google.avaliacoes} avaliações. Publicamos o texto de um cliente só com autorização de
        quem escreveu — por isso a seção mostra a nota e a distribuição, sem depoimento assinado.
      </p>

      {
        avaliacoes.length > 0 && (
          <ul class="nota__citacoes">
            {avaliacoes.map((item) => (
              <li class="nota__citacao">
                <blockquote>
                  <p>{item.texto}</p>
                </blockquote>
                <cite class="nota__autor">{item.autor}</cite>
              </li>
            ))}
          </ul>
        )
      }

      {
        google.url && (
          <p class="nota__link">
            <a href={google.url} target="_blank" rel="noopener noreferrer">
              Ver o perfil no Google
              <span class="sr-only"> (abre em nova aba)</span>
            </a>
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .nota {
    padding-block: var(--e7);
    background-color: var(--farinha);
    border-top: 1px solid var(--borda);
    scroll-margin-top: 72px;
  }

  .nota__interno {
    display: grid;
    /* minmax(0, …) impede a coluna de crescer com o gráfico. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--e6);
  }

  .nota__placar {
    min-width: 0;
    padding: var(--e5);
    background-color: var(--miolo);
    border: 1px solid var(--borda);
    border-radius: var(--r2);
    box-shadow: var(--sombra);
  }

  .nota__valor {
    display: flex;
    align-items: baseline;
    gap: var(--e2);
    font-family: var(--fonte-display);
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variation-settings: "SOFT" 30, "WONK" 1;
    color: var(--crosta);
  }

  .nota__de {
    font-family: var(--fonte-texto);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--tinta-suave);
  }

  .nota__estrelas {
    display: flex;
    gap: 2px;
    margin-top: var(--e3);
    font-size: var(--t-sm);
    line-height: 1;
  }

  .nota__estrela {
    color: var(--pedra);
  }

  .nota__estrela--cheia {
    color: var(--acafrao);
  }

  .nota__contagem {
    margin-top: var(--e2);
    font-size: var(--t-sm);
    line-height: 1.5;
    color: var(--tinta-suave);
  }

  .nota__distribuicao {
    display: grid;
    gap: 6px;
    margin-top: var(--e4);
    padding-top: var(--e4);
    border-top: 1px solid var(--borda);
  }

  .nota__linha {
    display: flex;
    align-items: center;
    gap: var(--e2);
  }

  .nota__linha-nota {
    width: 12px;
    font-size: var(--t-xs);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--tinta-suave);
  }

  .nota__trilho {
    flex: 1;
    height: 8px;
    border-radius: var(--r-pill);
    background-color: var(--farinha);
    overflow: hidden;
  }

  .nota__barra {
    display: block;
    height: 100%;
    min-width: 4px;
    border-radius: var(--r-pill);
    background-color: var(--acafrao);
  }

  .nota__ressalva {
    margin-top: var(--e3);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--tinta-suave);
  }

  .nota__conteudo {
    min-width: 0;
    max-width: var(--medida);
    align-self: center;
  }

  .nota__titulo {
    margin-top: var(--e2);
    font-size: var(--t-h2);
  }

  .nota__paragrafo {
    margin-top: var(--e3);
    font-size: var(--t-base);
    line-height: var(--lh-base);
    color: var(--tinta-suave);
  }

  .nota__citacoes {
    display: grid;
    gap: var(--e4);
    margin-top: var(--e5);
  }

  .nota__citacao {
    padding-left: var(--e4);
    border-left: 2px solid var(--borda-forte);
  }

  .nota__citacao blockquote p {
    font-family: var(--fonte-display);
    font-size: var(--t-lg);
    line-height: 1.45;
  }

  .nota__autor {
    display: block;
    margin-top: var(--e2);
    font-size: var(--t-xs);
    font-style: normal;
    color: var(--tinta-suave);
  }

  .nota__link {
    margin-top: var(--e4);
    font-size: var(--t-sm);
  }

  .nota__link a {
    color: var(--crosta);
    text-underline-offset: 4px;
  }

  @media (min-width: 900px) {
    .nota {
      padding-block: var(--e8);
    }

    .nota__interno {
      grid-template-columns: 280px minmax(0, 1fr);
      align-items: center;
      gap: var(--e8);
    }

    .nota__valor {
      font-size: 4.5rem;
    }
  }
</style>
