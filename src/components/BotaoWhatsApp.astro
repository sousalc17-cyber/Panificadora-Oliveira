---
/**
 * CTA de WhatsApp.
 *
 * O número (+55 89 99402-6283) foi confirmado como WhatsApp comercial pela
 * padaria, então `confirmado` é `true` e o link wa.me é renderizado. Se a
 * confirmação for revertida, o componente volta a um <button disabled>, nunca a
 * um link quebrado ou silenciosamente apontando para um telefone fixo.
 */
import site from '../content/site.json';

interface Props {
  rotulo?: string;
  variante?: 'primario' | 'fantasma';
  somenteIcone?: boolean;
  aviso?: boolean;
}

const {
  rotulo = 'Pedir pelo WhatsApp',
  variante = 'primario',
  somenteIcone = false,
  aviso = false,
} = Astro.props;

const { href, confirmado } = site.whatsapp;
const ativo = Boolean(confirmado && href);
const classes = [
  'botao',
  `botao--${variante}`,
  somenteIcone ? 'botao--icone' : '',
  ativo ? '' : 'botao--inativo',
]
  .filter(Boolean)
  .join(' ');
---

{
  ativo ? (
    <a
      class={classes}
      href={href as string}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${rotulo} (abre em nova aba)`}
    >
      <svg class="botao__icone" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-7l-5 4v-4H5a2 2 0 0 1-2-2V5Z"
        />
      </svg>
      {!somenteIcone && <span>{rotulo}</span>}
    </a>
  ) : (
    <button
      type="button"
      class={classes}
      disabled
      title="Número de WhatsApp ainda não confirmado pela padaria"
    >
      <svg class="botao__icone" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-7l-5 4v-4H5a2 2 0 0 1-2-2V5Z"
        />
      </svg>
      {!somenteIcone && <span>{rotulo}</span>}
      {somenteIcone && <span class="sr-only">{rotulo} — indisponível: número a confirmar</span>}
      {!somenteIcone && !aviso && <span class="sr-only">— indisponível: número a confirmar</span>}
    </button>
  )
}

{
  aviso && !ativo && (
    <p class="botao__aviso">
      [PENDENTE: confirmar que {site.whatsapp.numeroExibido} é WhatsApp comercial — link ainda
      desativado.
    </p>
  )
}

<style>
  .botao--icone {
    min-width: 44px;
    min-height: 44px;
    width: 44px;
    height: 44px;
    padding: 0;
  }

  /* Botão nativo desabilitado: o navegador já anuncia "indisponível". */
  .botao:disabled {
    opacity: 1;
  }
</style>
