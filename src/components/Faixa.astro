---
/**
 * Faixa — o único momento em que a fotografia vira plano de fundo.
 *
 * A fachada iluminada entra atrás do texto do horário, sob um véu de crosta
 * que garante contraste (o texto claro fica sobre 88% de crosta na base e 72%
 * na coluna do desktop). Enquanto o arquivo não estiver em `public/images`, a
 * faixa mantém a altura e a composição, com o fundo em degradê e um rótulo
 * discreto do que entra ali — sem imagem quebrada e sem mudança de layout.
 */
import BotaoWhatsApp from './BotaoWhatsApp.astro';
import { slot, temFoto } from '../lib/fotos';
import site from '../content/site.json';
import { enderecoCompleto, horaCurta } from '../lib/negocio';

const { horario } = site;
const foto = slot('fachada-panificadora-oliveira.webp');
const temFundo = temFoto(foto.arquivo);
---

<section class="faixa" class:list={[{ 'faixa--sem-foto': !temFundo }]} aria-labelledby="faixa-titulo">
  {
    temFundo && (
      <div class="faixa__fundo">
        <img
          src={`/images/${foto.arquivo}`}
          alt=""
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class="container faixa__interno">
    <h2 id="faixa-titulo" class="faixa__titulo">
      Das {horaCurta(horario.abre)} às {horaCurta(horario.fecha)}.
    </h2>
    <p class="faixa__texto">Todos os dias, na {enderecoCompleto}.</p>
    <p class="faixa__acao">
      <BotaoWhatsApp rotulo="Pedir pelo WhatsApp" variante="primario" />
    </p>
    {
      !temFundo && (
        <p class="faixa__reserva">Foto da fachada entra aqui · {foto.formato}</p>
      )
    }
  </div>
</section>

<style>
  .faixa {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: 448px;
    padding-block: var(--e8);
    overflow: hidden;
    background-color: var(--crosta);
    color: var(--miolo);
  }

  /* Sem foto, o fundo é o próprio crosta com um halo quente — composição
     fechada, não um retângulo vazio. */
  .faixa--sem-foto {
    background-image: radial-gradient(
      120% 90% at 18% 110%,
      rgb(201 134 47 / 0.28) 0%,
      transparent 62%
    );
  }

  .faixa__fundo {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .faixa__fundo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
  }

  /* Véu: escurece a base para o texto e deixa o letreiro respirar no topo. */
  .faixa::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(42 27 18 / 0.5) 0%, rgb(42 27 18 / 0.88) 100%),
      rgb(42 27 18 / 0.22);
  }

  .faixa--sem-foto::after {
    background: none;
  }

  .faixa__interno {
    position: relative;
  }

  .faixa__titulo {
    color: var(--miolo);
    font-size: var(--t-h2);
    letter-spacing: -0.02em;
  }

  .faixa__texto {
    margin-top: var(--e3);
    max-width: 44ch;
    font-size: var(--t-base);
    line-height: var(--lh-base);
    color: rgb(255 251 243 / 0.9);
  }

  .faixa__acao {
    margin-top: var(--e5);
  }

  .faixa__reserva {
    margin-top: var(--e4);
    font-size: var(--t-xs);
    line-height: 1.5;
    color: rgb(255 251 243 / 0.6);
  }

  @media (min-width: 900px) {
    .faixa {
      min-height: 520px;
      padding-block: var(--e9);
    }

    .faixa__titulo {
      font-size: clamp(2.5rem, 1.6rem + 2.6vw, 3.75rem);
    }

    .faixa__texto {
      margin-top: var(--e4);
      font-size: var(--t-lg);
      line-height: var(--lh-lg);
    }

    .faixa::after {
      background:
        linear-gradient(90deg, rgb(42 27 18 / 0.9) 0%, rgb(42 27 18 / 0.72) 46%, rgb(42 27 18 / 0.3) 100%),
        linear-gradient(180deg, rgb(42 27 18 / 0.24) 0%, rgb(42 27 18 / 0.42) 100%);
    }
  }
</style>
